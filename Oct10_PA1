import time

mod2_classes = {
        "A block": "Computer Science II",
        "B block": "Global Studies II",
        "C block": "Chemistry",
        "D block": "",
        "E block": ""
    }

def print_dict(schedule):
 for key in schedule:
        print(f"{key}: {schedule[key]}")

def add_class(schedule,user_block, user_class):
    schedule[user_block] = user_class
    print(f"\n~You have now added {user_class} as your {user_block}~")
    return schedule

def remove_class(schedule, user_block):
    schedule.pop(user_block)
    print(f"\n~You have dropped your class for {user_block}~")
    return schedule


def change_class(schedule, user_block, user_class):
    schedule[user_block] = user_class
    print(f"\n~You have changed your {user_block} to {user_class}~")
    return schedule

def error_handle(valid_answers, user_block):
    while user_block not in valid_answers:
        user_block = input(f"!Error! Please choose one of these options:{valid_answers} ").capitalize()
    return user_block


def main():

    loop_control = True
    while loop_control:

        print("Welcome to Mrs. Carroll's office for schedule requests!")

        for i in range(3):
            time.sleep(0.5)
            print("loading...")

        print("\nHere are your mod 2 classes at the moment:")
        print_dict(mod2_classes)

        correct_ans = ["Add", "Drop", "Change", "Exit"]
        
        time.sleep(2)
        ans = input(f"\nHow would you like to change your schedule classes?\n{correct_ans} ").capitalize()
        ans = error_handle(correct_ans, ans)
        
        
        if ans != "Exit":

            for i in range(3):
                time.sleep(0.5)
                print("processing...")

            user_choice = input(f"What block would you like to {ans.lower()}? ").capitalize()
            valid_blocks = ["A block", "B block", "C block", "D block"]
            user_choice = error_handle(valid_blocks, user_choice)
            
            if ans=="Add":
                '''
                user = input()
                while user not in my_dict.keys():
                    user = input()
                while my_dict[user] == "":
                    user = input()
                '''
                class_choice = input(f"What class would you like to {ans} to your schedule? ").capitalize()
                for i in range(3):
                    time.sleep(0.5)
                    print("loading new schedule...")
                mod2_classes=add_class(mod2_classes, user_choice, class_choice)
                print_dict(mod2_classes)

            elif ans=="Drop":
                user_choice = error_handle(valid_blocks, user_choice)
                for i in range(3):
                    time.sleep(0.5)
                    print("loading new schedule...")
                mod2_classes = remove_class(mod2_classes, user_choice)
                print_dict(mod2_classes)
                

            else:
                class_choice = input(f"What class would you like to {ans} as your {user_choice}? ").capitalize()

                for i in range(3):
                    time.sleep(0.5)
                    print("loading new schedule...")

                mod2_classes = change_class(mod2_classes, user_choice, class_choice)
                print_dict(mod2_classes)

            ans = input("Would you like to change anything else?").capitalize()
            ans = error_handle(correct_ans, ans)
            
        else:
            print("\n~Thanks for stopping by! Come again soon!~")
            loop_control = False

main()
