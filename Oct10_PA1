    }

mod_schedule = [mod1_classes, mod2_classes, season1_dblock, mod3_classes, mod4_classes, mod5_classes, season2_dblock, mod6_classes, mod7_classes, season3_dblock, evening_class]

def print_dict(schedule):
 for i in range(3):
    time.sleep(0.5)
    print("loading schedule...")
 for key in schedule:
        print(f"\n{key}: {schedule[key]}")

def add_class(schedule,user_block, user_class):
    schedule[user_block] = user_class
    print(f"\n~You have now added {user_class} as your {user_block}~")
    return schedule

def remove_class(schedule, user_block):
    schedule.pop(user_block)
    print(f"\n~You have dropped your class for {user_block}~\n")
    return schedule


def change_class(schedule, user_block, user_class):
    schedule[user_block] = user_class
    print(f"\n~You have changed your {user_block} to {user_class}~")
    return schedule

def schedule_error_handle(valid_answers, user_block, mod):
    while user_block not in mod.keys():
        user_block = input(f"!Error! Please choose one of these options:{valid_answers} ").capitalize()
    return user_block

def error_handle(valid_answer, user_input):
    while user_input not in valid_answer:
        user_input = input(f"!Error! Please choose one of these options:{valid_answer} ").capitalize()
    return user_input


def main():

    print("Welcome to Mrs. Carroll's office for schedule requests!")

    print("Here is your whole 7 mod schedule now: ")
    #print_dict(mod_schedule)

    for index in mod_schedule:

        loop_control = True
        while loop_control:

            print(f"\nHere are your classes for {index} at the moment:\n")
            print_dict(index)

            correct_ans = ["Add", "Drop", "Change", "No"]
            
            time.sleep(2)
            ans = input(f"\n Would you like to change your classes in this mod (if so, then how)?\n{correct_ans} ").capitalize()
            ans = error_handle(correct_ans, ans)
            
            if ans == "No":
                print("\n~No other changes will be done to this mod!~")
                loop_control = False

            else:

                for i in range(3):
                    time.sleep(0.5)
                    print("processing...")

                user_choice = input(f"What block would you like to {ans.lower()}? ").capitalize()
                valid_blocks = ["A block", "B block", "C block", "D block"]
                user_choice = schedule_error_handle(valid_blocks, user_choice, index)
                
                if ans=="Add":
                    if index[user_choice] == "":
                        class_choice = input(f"What class would you like to {ans} to your schedule? ").capitalize()
                    else:
                        user_choice = input("Please enter a block that is empty")
                    index=add_class(index, user_choice, class_choice)

                elif ans=="Drop":
                    user_choice = error_handle(valid_blocks, user_choice)
                    index = remove_class(index, user_choice)
                    
                else:
                    class_choice = input(f"What class would you like to {ans} your {user_choice} to? ").capitalize()
                    index = change_class(index, user_choice, class_choice)
            
            right_answers = ["Yes", "No"]
            done = input("\nWould you like to change anything else in your full mod 7 schedule? ").capitalize()
            error_handle(right_answers, done)
            if done == "Yes":
                break
            else:
                print("Thanks for stopping by!")
                
main()
