#Uses for loops to print out an individual dictionary with dividers and calls for the mod name as a parameter
def print_dict(schedule):
    for i in range(3):
        time.sleep(0.5)
        print("loading schedule...")
    print("~~~~~~~~~~~~~~~~~~~~~~~~~~~~")
    for key in schedule:
            print(f"{key}: {schedule[key]}")
    print("~~~~~~~~~~~~~~~~~~~~~~~~~~~~")

#Uses a for loop to define each dictionary in the list and then individually prints out those dictionaries and calls for no parameters
def print_schedule():
    print("\nHere is your full mod schedule for this school year currently:\n")
    for i in range(len(print_mod_schedule)): 
        name = print_mod_schedule_names[i] #In this for loop, i has to be defined as a number to also print out the schedule names
        time.sleep(0.5)
        print(f"{name} class/classes")
        a = print_mod_schedule[i]
        for key in a:
            print(f"{key}: {a[key]}")
        print("\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n")

#Adds a new class to a schedule using the dictionary index method and requires the mod name, the specific block (has to be a free block), and class the user wants to add
def add_class(mod,user_block, user_class):
    mod[user_block] = user_class
    print(f"\n~You have now added {user_class} as your {user_block}~")
    return mod

#Removes a class from a module using the pop method and requires the mod name and the specific block from the user
def remove_class(mod, user_block):
    mod.pop(user_block)
    print(f"\n~You have dropped your class for {user_block}~\n")
    return mod

#Changes a class using the same method as add, except user chooses the mod name, a block that is already there, and the class the user wants to change it to
def change_class(mod, user_block, user_class):
    mod[user_block] = user_class
    print(f"\n~You have changed your {user_block} to {user_class}~")
    return mod

#Handles errors in dictionaries, specifically for the add function, ensuring that there are free blocks the user can add to in the mod, and if not then giving an error message. 
#Requires the specific block and mod name as parameters
def schedule_error_handle(user_block, mod):
    while user_block not in mod.keys():
        user_block = input(f"!Error! Please choose one of the blocks stated in your mod above only: ").capitalize()
    return user_block

#Handles any errors for user input that does not contain the specific answers needed to alter the schedule.
def error_handle(valid_answer, user_input):
    while user_input not in valid_answer:
        print("Valid options:", *valid_answer, sep =', ')
        user_input = input(f"\n!Error! Please choose one of the options above: \n").capitalize()
    return user_input


